{
  "type": "object",
  "required": [
    "id",
    "language",
    "question",
    "question_latex",
    "subject",
    "knowledge_points",
    "prerequisites",
    "ability_tags",
    "difficulty",
    "difficulty_rationale",
    "difficulty_status",
    "task_type",
    "reference_solution",
    "final_answer",
    "scoring_rubric",
    "max_score",
    "critical_errors",
    "verification_method",
    "review",
    "source",
    "notes",
    "family_id",
    "split",
    "assets",
    "difficulty_profile"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^PROB-XJS-(?:\\d{2}|[ABC])-\\d{3}$"
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "zh"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "question_latex": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_points": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ability_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "difficulty_rationale": {
      "type": "string",
      "minLength": 1
    },
    "difficulty_status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "structurally_reviewed_uncalibrated"
      ]
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "proof",
        "computation_with_reasoning"
      ]
    },
    "reference_solution": {
      "type": "string",
      "minLength": 40
    },
    "final_answer": {
      "type": "string",
      "minLength": 1
    },
    "scoring_rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points",
          "ability",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "ability": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "max_score": {
      "type": "integer",
      "minimum": 4,
      "maximum": 4
    },
    "critical_errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_method": {
      "type": "object",
      "required": [
        "type",
        "exact_match",
        "proof_formalized"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "exact_match": {
          "type": "boolean"
        },
        "proof_formalized": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "human_reviewed",
        "checks",
        "external_comparison",
        "checked_on",
        "answer_verdict",
        "mathematical_rationale",
        "primary_reference_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "human_reviewed": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_comparison": {
          "type": "boolean"
        },
        "checked_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "answer_verdict": {
          "type": "string",
          "enum": [
            "valid_with_stated_assumptions"
          ]
        },
        "mathematical_rationale": {
          "type": "string",
          "minLength": 20
        },
        "primary_reference_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "document_id",
        "exercise",
        "chapter",
        "pdf_page",
        "printed_page",
        "equivalent_exercises",
        "adaptation",
        "solution_origin",
        "external_answer_checks"
      ],
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "exercise": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "string",
          "minLength": 1
        },
        "pdf_page": {
          "type": "integer",
          "minimum": 0
        },
        "printed_page": {
          "type": "integer",
          "minimum": 0
        },
        "equivalent_exercises": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adaptation": {
          "type": "string",
          "minLength": 1
        },
        "solution_origin": {
          "type": "string",
          "minLength": 1
        },
        "external_answer_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "url",
              "status",
              "scope"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "dev",
        "validation",
        "test"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "difficulty_profile": {
      "type": "object",
      "required": [
        "method_discovery",
        "reasoning_depth",
        "technical_control",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "method_discovery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "reasoning_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "technical_control": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "basis": {
          "type": "string",
          "enum": [
            "structural_three_axis_v1"
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zzjpp/Probability-Bench/schema/item.schema.json",
  "title": "Probability-Bench item"
}
